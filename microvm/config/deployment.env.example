# Private deployment configuration example. Copy outside Git as deployment.env.
# Literal, duplicate-free values only; values are never evaluated as shell code.
#
# Fill these with deployment-owned, owner-only paths and values. Do not commit
# credentials, collector URLs, session authorities, firmware/image assets or
# generated runtime trees. The guest validates signatures and acknowledgments
# before dispatching any workload.
BULL_MICROVM_APPROVED_WORKSPACE_ROOT=/private/bull/workspaces
BULL_MICROVM_APPROVED_RUNTIME_ROOT=/private/bull/runtimes
BULL_MICROVM_WORKSPACE=/private/bull/workspaces/request-0001
BULL_MICROVM_RUNTIME_DIR=/private/bull/runtimes/request-0001
BULL_MICROVM_KERNEL=/private/bull/images/bzImage
BULL_MICROVM_ROOTFS=/private/bull/images/rootfs.ext4
BULL_MICROVM_FIRMWARE=/usr/share/qemu/qboot.rom
BULL_MICROVM_FIRMWARE_SHA256=replace_with_pinned_sha256
BULL_MICROVM_CPU_PROFILE=host
BULL_MICROVM_CONTROL_SOCKET=/private/bull/run/request-0001/control.sock
BULL_MICROVM_AUDIT_SOCKET=/private/bull/run/request-0001/audit.sock
BULL_MICROVM_TIMEOUT_SECONDS=180
BULL_MICROVM_DEV_9P=false
