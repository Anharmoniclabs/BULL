# Literal KEY=value only: no quotes, substitutions, expansions, or inline comments.
# Copy to a private deployment file; set BOTH approved roots before launching.
# BULL_MICROVM_APPROVED_WORKSPACE_ROOT=/srv/bull/projects
# BULL_MICROVM_APPROVED_RUNTIME_ROOT=/srv/bull/runtime
# KERNEL, ROOTFS, QEMU, and ENGINE_GUEST must be pinned in the deployment file;
# flags and environment cannot override those trusted asset settings.
# Approved roots come ONLY from the explicit deployment configuration file.
BULL_MICROVM_MEMORY_MIB=4096
BULL_MICROVM_CPUS=2
BULL_MICROVM_ACCEL=kvm
BULL_MICROVM_QEMU=qemu-system-x86_64
BULL_MICROVM_ENGINE_GUEST=/bull_runtime/bin/bull-engine
BULL_MICROVM_TIMEOUT_SECONDS=3600
BULL_MICROVM_DEV_9P=false
# Relative to the launcher's working directory; must be outside all inputs.
BULL_MICROVM_OUTPUT_DIR=./project_outputs
BULL_MICROVM_OUTPUT_MAX_BYTES=1048576
