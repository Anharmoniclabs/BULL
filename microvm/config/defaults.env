# Literal KEY=value only: no quotes, substitutions, expansions, or inline comments.
# Copy to a private deployment file OUTSIDE the repository; set BOTH approved roots.
# The paths below are placeholders, not local deployment settings.
# BULL_MICROVM_APPROVED_WORKSPACE_ROOT=/absolute/path/to/private/projects
# BULL_MICROVM_APPROVED_RUNTIME_ROOT=/absolute/path/to/private/runtime
# Flags override environment, then configuration, then built-in defaults.
# Approved roots come ONLY from the explicit deployment configuration file.
BULL_MICROVM_MEMORY_MIB=4096
BULL_MICROVM_CPUS=2
BULL_MICROVM_ACCEL=kvm
BULL_MICROVM_QEMU=qemu-system-x86_64
BULL_MICROVM_ENGINE_GUEST=/bull_runtime/bin/bull-engine
BULL_MICROVM_TIMEOUT_SECONDS=3600
BULL_MICROVM_DEV_9P=false
