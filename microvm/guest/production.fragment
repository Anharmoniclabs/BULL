# Merge into the pinned Buildroot guest defconfig, then run olddefconfig.
# ClamAV also needs the transitive dependencies selected by its Config.in.
BR2_INSTALL_LIBSTDCPP=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_CLAMAV=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_UNSHARE=y
BR2_PACKAGE_LIBSECCOMP=y
