#!/bin/sh

set -eu

# Never run guest mount or shutdown commands from an ordinary host shell.
[ "$$" -eq 1 ] || { echo 'bull-init must run as guest PID 1' >&2; exit 78; }

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

log() {
    printf '%s\n' "[bull-microvm] $*" >/dev/console
}

shutdown() {
    sync || true
    if command -v poweroff >/dev/null 2>&1; then
        poweroff -f >/dev/null 2>&1 || true
    fi
    if command -v reboot >/dev/null 2>&1; then
        reboot -f >/dev/null 2>&1 || true
    fi
    # Returning from PID 1 would panic the kernel if shutdown failed.
    while :; do sleep 1; done
}

fail() {
    log "FATAL: $*"
    shutdown
}

# Unexpected setup failures also halt rather than returning from PID 1.
trap shutdown EXIT

# These mountpoints must exist in the immutable rootfs before boot.
for directory in /dev /proc /sys /run /tmp /workspace /bull_runtime; do
    [ -d "$directory" ] && [ ! -L "$directory" ] || fail "invalid mountpoint $directory"
done

mount -t devtmpfs -o nosuid,noexec,mode=0755 devtmpfs /dev 2>/dev/null \
    || mount -t tmpfs -o nosuid,noexec,mode=0755 tmpfs /dev
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t tmpfs -o nosuid,nodev,noexec,mode=0755,size=128m tmpfs /run
mount -t tmpfs -o nosuid,nodev,noexec,mode=1777,size=128m tmpfs /tmp

mount_9p() {
    tag="$1"
    target="$2"
    attempt=0
    while ! mount -t 9p -o trans=virtio,version=9p2000.L,ro "$tag" "$target"; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 50 ]; then
            fail "unable to mount read-only host export $tag at $target"
        fi
        sleep 0.1
    done
}

cmdline_value() {
    key="$1"
    for word in $(cat /proc/cmdline); do
        case "$word" in
            "$key="*) printf '%s' "${word#*=}"; return 0 ;;
        esac
    done
    return 1
}

if [ "$(cmdline_value bull.dev9p || true)" = true ]; then
    log "DEVELOPMENT: live 9P exports enabled"
    mount_9p bull_workspace /workspace
    mount_9p bull_runtime /bull_runtime
else
    mount -t ext4 -o ro,noload,nosuid,nodev,noexec /dev/vdb /workspace || fail "workspace image mount failed"
    mount -t ext4 -o ro,noload,nosuid,nodev /dev/vdc /bull_runtime || fail "runtime image mount failed"
fi

# A non-recursive private bind preserves the immutable input view without the
# nested output mount. Admission must continue rejecting filesystem crossings.
mount --make-rprivate / || fail "cannot make guest mounts private"
mkdir /run/bull-input
mount --bind /workspace /run/bull-input || fail "input bind failed"
mount -o remount,bind,ro,nosuid,nodev,noexec /run/bull-input || fail "input bind is not read-only"
[ -d /workspace/outputs ] && [ ! -L /workspace/outputs ] || fail "missing output mountpoint"
[ "$(readlink -f /workspace/outputs)" = /workspace/outputs ] || fail "output path is not canonical"
mount -t 9p -o trans=virtio,version=9p2000.L,rw,nosuid,nodev,noexec,cache=none bull_outputs /workspace/outputs \
    || fail "output export mount failed"
awk '$1 == "bull_outputs" && $2 == "/workspace/outputs" && $3 == "9p" && ("," $4 ",") ~ /,rw,/ { found=1 } END { exit !found }' /proc/mounts \
    || fail "output export is not mounted read-write"
probe=$(mktemp /workspace/outputs/.bull-probe.XXXXXXXX) || fail "output export is not writable"
printf 'bull-output-probe\n' >"$probe" || fail "output write failed"
[ "$(cat "$probe")" = bull-output-probe ] || fail "output readback failed"
rm -- "$probe" || fail "output probe cleanup failed"

engine="$(cmdline_value bull.engine || true)"
case "$engine" in
    /bull_runtime/*) ;;
    *) fail "bull.engine must name an executable below /bull_runtime" ;;
esac

case "$engine" in
    *[[:space:],]*) fail "bull.engine contains an unsupported whitespace or comma" ;;
    */../*|*/..|*/./*|*/.|*//* ) fail "bull.engine must use a normalized path below /bull_runtime" ;;
esac

[ -f "$engine" ] || fail "BULL engine does not exist: $engine"
[ -x "$engine" ] || fail "BULL engine is not executable: $engine"
[ ! -L "$engine" ] || fail "BULL engine may not be a symlink: $engine"
component_path=/bull_runtime
relative=${engine#/bull_runtime/}
old_ifs=$IFS
IFS=/
for component in $relative; do
    component_path=$component_path/$component
    [ ! -L "$component_path" ] || fail "engine parent symlink forbidden"
done
IFS=$old_ifs
[ "$(readlink -f "$engine")" = "$engine" ] || fail "engine canonical path mismatch"

export BULL_MICROVM=1
export BULL_WORKSPACE=/run/bull-input
export BULL_RUNTIME=/bull_runtime
export BULL_OUTPUTS=/workspace/outputs

log "read-only workspace and trusted runtime mounted"
log "starting trusted engine $engine"
child=
stop_engine() {
    if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null || true; fi
}
trap stop_engine TERM INT HUP
"$engine" --workspace /run/bull-input --runtime /bull_runtime --outputs /workspace/outputs &
child=$!
status=0
wait "$child" || status=$?
log "trusted engine exited with status $status"
# PID 1 inherits orphaned descendants.  Reap every remaining child before
# shutdown so a failed adapter cannot leave guest zombies behind.
while wait -n 2>/dev/null; do :; done
shutdown
